LINDA_SECRET=replace-with-a-long-random-secret
# Local development: sqlite:///var/linda.db
# Vercel production: Neon DATABASE_URL injected by the Marketplace integration.
DATABASE_URL=sqlite:///var/linda.db
DEMO_MODE=true
# NVIDIA NIM / API Catalog — server-only; never expose in VITE_* variables.
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.1-70b-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,https://linda-node.vercel.app
COOKIE_SECURE=false
PUBLIC_BASE_URL=http://localhost:8000
ICPAC_BASE=https://eatriggersthresholds.icpac.net
HTTP_TIMEOUT_S=8
SNAPSHOT_TTL_MIN=30
# Vercel Blob injects BLOB_READ_WRITE_TOKEN for a directly connected store. The
# separate API project uses this scoped copy of the private store token.
LINDA_BLOB_READ_WRITE_TOKEN=
