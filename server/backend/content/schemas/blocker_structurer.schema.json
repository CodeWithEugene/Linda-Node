{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Linda Node Blocker Structurer v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["code", "severity", "summary", "needs_human_review"],
  "properties": {
    "code": {
      "type": "string",
      "enum": ["LOGISTICS_TRANSPORT", "LOGISTICS_STORAGE", "FINANCE_UNAVAILABLE", "FINANCE_DELAYED", "AUTHORITY_APPROVAL_MISSING", "DATA_MISSING", "SECURITY_ACCESS", "STAFFING", "MARKET_CONDITIONS", "OTHER"]
    },
    "severity": {"type": "string", "enum": ["critical", "normal"]},
    "summary": {"type": "string", "minLength": 1, "maxLength": 1000},
    "needs_human_review": {"type": "boolean"}
  }
}
