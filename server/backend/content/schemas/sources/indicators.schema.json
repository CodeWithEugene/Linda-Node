{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ICPAC indicator registry",
  "type": "object",
  "required": ["indicators"],
  "properties": {
    "indicators": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["code", "name", "category", "supports_forecast", "supports_monitoring"],
        "properties": {
          "code": { "type": "string" },
          "name": { "type": "string" },
          "category": { "type": ["string", "null"] },
          "data_source": { "type": ["string", "null"] },
          "unit": { "type": ["string", "null"] },
          "description": { "type": ["string", "null"] },
          "supports_forecast": { "type": "boolean" },
          "supports_monitoring": { "type": "boolean" },
          "timescale_months": { "type": ["integer", "null"] }
        }
      }
    }
  }
}
