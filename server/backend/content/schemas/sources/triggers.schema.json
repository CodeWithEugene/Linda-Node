{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ICPAC Thresholds & Triggers rule/event/action payload",
  "description": "Validates the shape Linda depends on from /api/triggers/*. Extra upstream fields are allowed; missing required fields mark the snapshot schema_ok=0.",
  "type": "object",
  "required": ["rules", "events", "actions"],
  "properties": {
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "area_id", "indicator"],
        "properties": {
          "id": { "type": ["string", "integer"] },
          "name": { "type": "string" },
          "area_id": { "type": "string" },
          "indicator": { "type": "string" },
          "severity": { "type": ["string", "null"] },
          "hazard": { "type": ["string", "null"] },
          "threshold_value": { "type": ["number", "null"] },
          "active": { "type": "boolean" }
        }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "area_id"],
        "properties": {
          "id": { "type": ["string", "integer"] },
          "name": { "type": "string" },
          "area_id": { "type": "string" },
          "hazard": { "type": ["string", "null"] },
          "value": { "type": ["number", "null"] },
          "severity": { "type": ["string", "null"] }
        }
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "action_type"],
        "properties": {
          "id": { "type": ["string", "integer"] },
          "name": { "type": "string" },
          "action_type": { "type": "string" },
          "status": { "type": ["string", "null"] },
          "area_id": { "type": ["string", "null"] }
        }
      }
    },
    "check_logs": { "type": "array" }
  }
}
