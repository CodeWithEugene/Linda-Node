{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Linda Node action card",
  "type": "object",
  "required": [
    "id", "hazard", "title", "description", "owner_role", "lead_time_days",
    "stage_required", "budget", "effectiveness", "prerequisites", "disclaimer"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^card_[a-z0-9_]+_v[0-9]+$" },
    "hazard": { "type": "string", "enum": ["drought", "flood", "heat"] },
    "title": { "type": "string", "minLength": 3 },
    "description": { "type": "string", "minLength": 10 },
    "owner_role": { "type": "string", "enum": ["ews_specialist", "county_drm_officer", "ngo_finance_lead"] },
    "supporting_roles": {
      "type": "array",
      "items": { "type": "string", "enum": ["ews_specialist", "county_drm_officer", "ngo_finance_lead"] }
    },
    "lead_time_days": { "type": "integer", "minimum": 1 },
    "stage_required": { "type": "string", "enum": ["ready", "set", "go"] },
    "budget": {
      "type": "object",
      "required": ["currency", "readiness_tranche", "action_tranche"],
      "properties": {
        "currency": { "type": "string", "minLength": 3 },
        "readiness_tranche": { "$ref": "#/$defs/tranche" },
        "action_tranche": { "$ref": "#/$defs/tranche" }
      }
    },
    "effectiveness": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
    "prerequisites": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "criticality"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string", "minLength": 3 },
          "criticality": { "type": "string", "enum": ["critical", "normal"] }
        }
      }
    },
    "evidence_required": { "type": "array", "items": { "type": "string" } },
    "citations": { "type": "array", "items": { "type": "string" } },
    "disclaimer": { "type": "string", "minLength": 10 }
  },
  "$defs": {
    "tranche": {
      "type": "object",
      "required": ["amount", "released_at_stage", "items"],
      "properties": {
        "amount": { "type": "number", "minimum": 0 },
        "released_at_stage": { "type": "string", "enum": ["ready", "set", "go"] },
        "items": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    }
  }
}
